{
  "name": "bbmp-pothole-complaint",
  "version": "0.1.0",
  "description": "BBMP pothole complaint agent: shared core, MCP servers and demo website",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.10" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start:web": "node dist/web/server.js",
    "start:mcp:vision": "node dist/mcp/vision.js",
    "start:mcp:maps": "node dist/mcp/maps.js",
    "start:mcp:complaints": "node dist/mcp/complaints.js",
    "start:mcp:whatsapp": "node dist/mcp/whatsapp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
