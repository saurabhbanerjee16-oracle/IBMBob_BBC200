# Copy to .env and fill in. Never commit real secrets.
# Every variable is optional for a local demo: defaults use mock vision, template text
# and an on-disk email outbox.

# ---- Google Maps ----
# Server key for the Geocoding API (reverse geocode / geocode). Without it, addresses stay null.
GOOGLE_MAPS_API_KEY=
# Browser key for the Maps JavaScript API. Restrict it by HTTP referrer in Google Cloud.
# Without it the web pages fall back to manual latitude/longitude entry.
GOOGLE_MAPS_BROWSER_KEY=

# ---- Vision + text AI (OpenAI-compatible chat completions API) ----
# VISION_PROVIDER: mock (demo, no network) | openai
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=https://api.openai.com/v1
# TEXT_PROVIDER (Kannada + English drafting): template | openai. Reuses the key/base URL above.
TEXT_PROVIDER=template
TEXT_MODEL=
# Below this confidence the photo is rejected and the user is asked for a better one.
VISION_MIN_CONFIDENCE=0.5

# ---- Ward data ----
# Path to the ward GeoJSON (relative to project root) and its property names. Source is an open item.
WARDS_GEOJSON=data/bbmp-wards.geojson
WARD_NAME_PROPERTY=
WARD_ZONE_PROPERTY=

# ---- Email ----
# EMAIL_TRANSPORT: outbox (writes .eml files to outbox/, demo) | smtp
EMAIL_TRANSPORT=outbox
# Outbox mode only: recipient used when config/bbmp-contacts.json has none. Not a real BBMP address.
DEMO_RECIPIENT=outbox@bbmp-demo.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- WhatsApp Business Cloud API (unverified; needs a public webhook) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify the X-Hub-Signature-256 header on webhook posts.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_PORT=8788

# ---- Web backend ----
PORT=8787
# Officer shared credential. The server refuses to start the officer area if these are empty.
OFFICER_USERNAME=
OFFICER_PASSWORD=
# Random string, 32+ characters, used to sign the officer session cookie.
SESSION_SECRET=
# Set to false only for plain-HTTP local development; keep true behind HTTPS.
COOKIE_SECURE=true
# Number of reverse-proxy hops in front of the server (0 = none). Needed for correct per-IP rate limiting behind a proxy.
TRUST_PROXY=0
